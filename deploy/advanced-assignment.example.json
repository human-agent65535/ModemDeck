{
  "version": 1,
  "poll_interval_ms": 1000,
  "settle_ms": 750,
  "port_ready_timeout_ms": 5000,
  "host": {
    "proc_root": "/run/host-proc",
    "system_bus_address": "unix:path=/run/host-dbus/system_bus_socket"
  },
  "assignments": [
    {
      "id": "REPLACE_WITH_LINE_ID",
      "required_at_startup": true,
      "match": {
        "usb": {
          "vendor_id": "2c7c",
          "product_id": "0125",
          "serial": "REPLACE_WITH_UNIQUE_USB_SERIAL"
        }
      }
    }
  ]
}
