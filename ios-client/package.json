{
  "name": "modemdeck-ios",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node ../scripts/build-native-audio-core.mjs --host && node --test tests/*.test.mjs",
    "build:ios": "node ../scripts/build-native-audio-core.mjs --ios && node ./scripts/build-ios.mjs",
    "run:ios": "node ./scripts/run-ios.mjs",
    "run:ios:iphone": "MODEMDECK_SIMULATOR_FAMILY=iphone node ./scripts/run-ios.mjs",
    "run:ios:ipad": "MODEMDECK_SIMULATOR_FAMILY=ipad node ./scripts/run-ios.mjs",
    "open:ios": "open ios/App/App.xcodeproj"
  }
}
