# Docker Compose application settings only. Host-agent settings belong in
# /etc/modemdeck/agent.env and are never passed into the application container.
MODEMDECK_IMAGE=modemdeck
MODEMDECK_VERSION=dev
MODEMDECK_BIND_ADDRESS=127.0.0.1
MODEMDECK_PORT=7575
MODEMDECK_UID=10001
MODEMDECK_GID=10001
MODEMDECK_AGENT_GID=10002
MODEMDECK_ADMIN_USERNAME=admin
MODEMDECK_ADMIN_PASSWORD_FILE=./secrets/admin-password
MODEMDECK_SETTINGS_KEY_FILE=./secrets/settings-key
# Set true only when the browser reaches ModemDeck through HTTPS.
MODEMDECK_SECURE_COOKIES=false
