# Docker Compose deployment settings. Keep deployment-specific values in .env.
MODEMDECK_IMAGE=modemdeck
MODEMDECK_WEB_IMAGE=modemdeck-web
MODEMDECK_HARDWARE_IMAGE=modemdeck-hardware
MODEMDECK_VERSION=dev
# Nginx publishes only the HTTPS Web listener. Port 7575 remains Compose-only
# for the Cloudflare API connector.
MODEMDECK_BIND_ADDRESS=127.0.0.1
MODEMDECK_PORT=7577
MODEMDECK_TLS_HOSTS=localhost,127.0.0.1,::1
MODEMDECK_UID=10001
MODEMDECK_GID=10001
MODEMDECK_AGENT_GID=10002
MODEMDECK_SETTINGS_KEY_FILE=./secrets/settings-key
MODEMDECK_DATA_DIR=./data
# Optional explicit modem audio bindings. The checked-in empty file disables
# browser call audio without claiming unsupported hardware capability.
MODEMDECK_MEDIA_BINDINGS_FILE=./hardware/config/media-bindings.empty.json
# iOS pairing is available only when this optional Cloudflare Tunnel integration
# is enabled and healthy. Configure the Tunnel's public hostname service as
# http://modemdeck:7575 in Cloudflare.
MODEMDECK_CLOUDFLARE_ENABLED=false
MODEMDECK_CLOUDFLARE_HOSTNAME=
MODEMDECK_CLOUDFLARE_PUBLIC_URL=
MODEMDECK_CLOUDFLARE_TOKEN_FILE=./secrets/cloudflare-tunnel-token
MODEMDECK_CLOUDFLARED_VERSION=2026.7.3
MODEMDECK_CLOUDFLARED_DIGEST=sha256:e39ee8da81ad5e05d77f38d2f51c60ca51bf2a8450ac3abab50c17fdb91d91bf
